# URL base de TIL_Backend incluyendo /api/v1 (obligatoria). En producción debe ser https://
# Se sobreescribe por .env.development / .env.production según el modo de Vite.
# El login y los datos salen de este backend; las credenciales las genera TIL_Superadmin.
# No pongas secretos aquí: las variables VITE_* son visibles en el navegador.
VITE_API_URL=http://localhost:4000/api/v1
